# Local development. Copy to .env and fill in. Never commit .env.
# Free key from https://aistudio.google.com/apikey (on Cloud Run, leave empty to use Vertex AI).
GEMINI_API_KEY=
GEMINI_MODEL=
# Set to 1 to use Firestore (needs GOOGLE_CLOUD_PROJECT and credentials).
USE_FIRESTORE=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
PORT=8080
# Telegram bot (from @BotFather). Locally use TELEGRAM_MODE=polling; on Cloud Run use a webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# Secret for hashing recruiter contacts (any long random string).
FINGERPRINT_SECRET=
